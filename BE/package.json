{
  "name": "fashionheaven",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prestart": "npm run db:prepare",
    "start": "ts-node src/server.ts",
    "predev": "npm run db:prepare",
    "dev": "nodemon src/server.ts",
    "db:migrate-orders": "ts-node migrate_order_tables.ts",
    "db:prepare": "npm run db:migrate-orders && npm run db:migrate-inventory && npm run db:migrate-order-safety && npm run db:migrate-accounts-media && npm run db:migrate-store-settings && prisma generate",
    "db:migrate-inventory": "ts-node migrate_inventory.ts",
    "seed:catalog": "ts-node seed_catalog.ts",
    "seed:samples": "ts-node add_sample_data.ts",
    "db:extend-product-variants": "ts-node update_variant_schema.ts",
    "data:seed-category-attributes": "ts-node update_category_attributes.ts",
    "test": "ts-node tests/run-integration.ts",
    "typecheck": "tsc --noEmit --ignoreDeprecations 6.0",
    "db:migrate-order-safety": "ts-node migrate_order_safety.ts",
    "db:migrate-accounts-media": "ts-node migrate_accounts_media.ts",
    "demo:customer": "ts-node scripts/provision-demo-customer.ts",
    "test:db:list": "ts-node scripts/cleanup-test-databases.ts --list",
    "test:db:cleanup": "ts-node scripts/cleanup-test-databases.ts",
    "db:migrate-store-settings": "ts-node migrate_store_settings.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.5.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemon": "^3.0.1",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10"
  }
}

DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/FashionHeaven"
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
PORT=4000

# Explicit local customer provisioning; requires NODE_ENV=development.
# Never run automatically or in production.
# Fill private values in BE/.env, then run npm.cmd run demo:customer.
ALLOW_DEMO_CUSTOMER=false
DEMO_CUSTOMER_EMAIL=""
DEMO_CUSTOMER_PASSWORD=""
DEMO_CUSTOMER_NAME="Khách thử nghiệm Fashion Haven"

# Password recovery: file outbox only in development/test, or real Resend delivery.
# Leave empty until configured. Missing configuration returns 503, never a fake email.
RESET_DELIVERY_MODE=""
CUSTOMER_WEB_URL="http://localhost:8081"
RESET_EMAIL_FROM=""
RESEND_API_KEY=""

# The test runner removes only its own disposable database by default.
KEEP_TEST_DB=false

# Separate persistent demonstration database fashionhaven_demo_v1 (never shop data).
# Set NODE_ENV=development, ALLOW_DEMO_DATA=true, and supply a private password locally.
# npm.cmd run demo:data:plan ; npm.cmd run demo:data:provision ; npm.cmd run demo:dev
ALLOW_DEMO_DATA=false
DEMO_DATA_PASSWORD=""

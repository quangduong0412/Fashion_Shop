generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ChucVu {
  MaChucVu  Int        @id @default(autoincrement())
  TenChucVu String     @db.VarChar(255)
  nhanViens NhanVien[]

  @@map("chucvu")
}

model ChiNhanh {
  MaChiNhanh  Int        @id @default(autoincrement())
  TenChiNhanh String     @db.VarChar(255)
  DiaChi      String     @db.Text
  DienThoai   String     @db.VarChar(50)
  nhanViens   NhanVien[]

  @@map("chinhanh")
}

model NhanVien {
  MaNhanVien      Int              @id @default(autoincrement())
  TenNhanVien     String           @db.VarChar(255)
  MaChucVu        Int
  MaChiNhanh      Int
  NgaySinh        DateTime?
  GioiTinh        String?          @db.VarChar(50)
  DiaChi          String?          @db.Text
  DienThoai       String?          @db.VarChar(50)
  account         Account?
  chiNhanh        ChiNhanh         @relation(fields: [MaChiNhanh], references: [MaChiNhanh], onUpdate: NoAction, map: "FK__NhanVien__MaChiN__3C69FB99")
  chucVu          ChucVu           @relation(fields: [MaChucVu], references: [MaChucVu], onUpdate: NoAction, map: "FK__NhanVien__MaChuc__3B75D760")
  phieuNhaps      PhieuNhap[]
  phieuXuats      PhieuXuat[]
  yeuCauNhapHangs YeuCauNhapHang[]

  @@map("nhanvien")
}

model Account {
  MaNhanVien Int      @id
  UserName   String   @unique @db.VarChar(255)
  PassWord   String   @db.VarChar(255)
  Role       String   @default("USER") @db.VarChar(50)
  nhanVien   NhanVien @relation(fields: [MaNhanVien], references: [MaNhanVien], onUpdate: NoAction, map: "FK__Account__MaNhanV__403A8C7D")

  @@map("account")
}

model KhachHang {
  MaKhachHang   Int         @id @default(autoincrement())
  TenKhach      String      @db.VarChar(255)
  Email         String      @unique @db.VarChar(255)
  MatKhau       String      @db.VarChar(255)
  DiaChi        String?     @db.Text
  DienThoai     String?     @db.VarChar(50)
  HangThanhVien String?     @db.VarChar(100)
  phieuXuats    PhieuXuat[]

  @@map("khachhang")
}

model LoaiHang {
  MaLoaiHang  Int       @id @default(autoincrement())
  TenLoaiHang String    @db.VarChar(255)
  sanPhams    SanPham[]

  @@map("loaihang")
}

model Kho {
  MaKho      Int         @id @default(autoincrement())
  TenKho     String      @db.VarChar(255)
  DiaChi     String      @db.Text
  phieuNhaps PhieuNhap[]
  phieuXuats PhieuXuat[]
  sanPhams   SanPham[]

  @@map("kho")
}

model NhaCungCap {
  MaNCC      Int         @id @default(autoincrement())
  TenNCC     String      @db.VarChar(255)
  DiaChi     String?     @db.Text
  DienThoai  String?     @db.VarChar(50)
  phieuNhaps PhieuNhap[]
  sanPhams   SanPham[]

  @@map("nhacungcap")
}

model SanPham {
  MaSanPham       Int              @id @default(autoincrement())
  TenSanPham      String           @db.VarChar(255)
  MaLoaiHang      Int
  SoLuong         Int              @default(0)
  DonGiaNhap      Float
  DonGiaBan       Float
  Anh             String?          @db.Text
  GhiChu          String?          @db.Text
  MaKho           Int
  MaNCC           Int
  TrangThai       String           @default("Đang mở bán") @db.VarChar(50)
  ctPhieuNhaps    CTPhieuNhap[]
  ctDonHangs      CTDonHang[]
  bienThes        BienTheSanPham[]
  kho             Kho              @relation(fields: [MaKho], references: [MaKho], onUpdate: NoAction, map: "FK__SanPham__MaKho__4E88ABD4")
  loaiHang        LoaiHang         @relation(fields: [MaLoaiHang], references: [MaLoaiHang], onUpdate: NoAction, map: "FK__SanPham__MaLoaiH__4CA06362")
  nhaCungCap      NhaCungCap       @relation(fields: [MaNCC], references: [MaNCC], onUpdate: NoAction, map: "FK__SanPham__MaNCC__4F7CD00D")
  yeuCauNhapHangs YeuCauNhapHang[]

  @@map("sanpham")
}

model BienTheSanPham {
  MaBienThe Int     @id @default(autoincrement())
  MaSanPham Int
  KichCo    String  @db.VarChar(10)
  MauSac    String? @db.VarChar(50)
  SoLuong   Int     @default(0)
  sanPham   SanPham @relation(fields: [MaSanPham], references: [MaSanPham], onUpdate: NoAction, onDelete: Cascade, map: "FK__BienThe__MaSan__XX")

  @@map("bienthesanpham")
}

model YeuCauNhapHang {
  MaNhanVien Int
  MaSanPham  Int
  ThoiGian   DateTime @default(now())
  nhanVien   NhanVien @relation(fields: [MaNhanVien], references: [MaNhanVien], onUpdate: NoAction, map: "FK__YeuCauNha__MaNha__52593CB8")
  sanPham    SanPham  @relation(fields: [MaSanPham], references: [MaSanPham], onUpdate: NoAction, map: "FK__YeuCauNha__MaSan__534D60F1")

  @@id([MaNhanVien, MaSanPham, ThoiGian])
  @@map("yeucaunhaphang")
}

model PhieuNhap {
  MaPhieuNhap  Int           @id @default(autoincrement())
  MaNhanVien   Int
  NgayNhap     DateTime      @default(now())
  MaNCC        Int
  TongTien     Float
  MaKho        Int
  TrangThai    String        @default("Chờ kiểm duyệt") @db.VarChar(50)
  ctPhieuNhaps CTPhieuNhap[]
  kho          Kho           @relation(fields: [MaKho], references: [MaKho], onUpdate: NoAction, map: "FK__PhieuNhap__MaKho__59FA5E80")
  nhaCungCap   NhaCungCap    @relation(fields: [MaNCC], references: [MaNCC], onUpdate: NoAction, map: "FK__PhieuNhap__MaNCC__59063A47")
  nhanVien     NhanVien      @relation(fields: [MaNhanVien], references: [MaNhanVien], onUpdate: NoAction, map: "FK__PhieuNhap__MaNha__571DF1D5")

  @@map("phieunhap")
}

model CTPhieuNhap {
  STT         Int       @id @default(autoincrement())
  MaPhieuNhap Int
  MaSanPham   Int
  SoLuong     Int
  DonGiaNhap  Float
  GiamGia     Float     @default(0)
  ThanhTien   Float
  phieuNhap   PhieuNhap @relation(fields: [MaPhieuNhap], references: [MaPhieuNhap], onUpdate: NoAction, map: "FK__CTPhieuNh__MaPhi__5CD6CB2B")
  sanPham     SanPham   @relation(fields: [MaSanPham], references: [MaSanPham], onUpdate: NoAction, map: "FK__CTPhieuNh__MaSan__5DCAEF64")

  @@map("ctphieunhap")
}

model PhieuXuat {
  MaPhieuXuat  Int           @id @default(autoincrement())
  MaNhanVien   Int
  NgayXuat     DateTime      @default(now())
  MaKhachHang  Int
  TongTien             Float
  MaKho                Int
  TrangThai            String        @default("PENDING") @db.VarChar(50)
  PhuongThucThanhToan  String?       @db.VarChar(50)
  TrangThaiThanhToan   String?       @db.VarChar(50)
  DonViVanChuyen       String?       @db.VarChar(100)
  MaVanDon             String?       @db.VarChar(100)
  ctDonHangs           CTDonHang[]
  khachHang            KhachHang     @relation(fields: [MaKhachHang], references: [MaKhachHang], onUpdate: NoAction, map: "FK__PhieuXuat__MaKha__6383C8BA")
  kho                  Kho           @relation(fields: [MaKho], references: [MaKho], onUpdate: NoAction, map: "FK__PhieuXuat__MaKho__6477ECF3")
  nhanVien             NhanVien      @relation(fields: [MaNhanVien], references: [MaNhanVien], onUpdate: NoAction, map: "FK__PhieuXuat__MaNha__619B8048")

  @@map("donhang")
}

model CTDonHang {
  STT         Int       @id @default(autoincrement())
  MaPhieuXuat Int
  MaSanPham   Int
  SoLuong     Int
  DonGiaBan   Float
  GiamGia     Float     @default(0)
  ThanhTien   Float
  donHang     PhieuXuat @relation(fields: [MaPhieuXuat], references: [MaPhieuXuat], onUpdate: NoAction, map: "FK__CTPhieuXu__MaPhi__68487DD7")
  sanPham     SanPham   @relation(fields: [MaSanPham], references: [MaSanPham], onUpdate: NoAction, map: "FK__CTPhieuXu__MaSan__693CA210")

  @@map("ctdonhang")
}

model BaiViet {
  MaBaiViet Int      @id @default(autoincrement())
  TieuDe    String   @db.VarChar(255)
  MoTa      String   @db.Text
  Anh       String   @db.Text
  TheLoai   String   @db.VarChar(50)
  NgayTao   DateTime @default(now())

  @@map("baiviet")
}

model LienHe {
  MaLienHe Int      @id @default(autoincrement())
  HoTen    String   @db.VarChar(255)
  Email    String   @db.VarChar(255)
  NoiDung  String   @db.Text
  NgayTao  DateTime @default(now())

  @@map("lienhe")
}

model sysdiagrams {
  name         String @db.VarChar(128)
  principal_id Int
  diagram_id   Int    @id @default(autoincrement())
  version      Int?
  definition   Bytes?

  @@unique([principal_id, name])
}
